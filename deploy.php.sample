<?php

namespace Deployer;

require_once __DIR__ . '/vendor/taurus/module-deployer/recipe/taurus-magento2.php';

// Config
set('repository', '<repository_url>');

// Hosts
host('production')
    ->setHostname('<production_hostname>')
    ->setRemoteUser('app')
    ->setDeployPath('~/magento2');

host('staging')
    ->setHostname('<staging_hostname>')
    ->setRemoteUser('app')
    ->setDeployPath('~/magento2_staging');
