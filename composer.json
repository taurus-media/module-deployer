{
    "name": "taurus/module-deployer",
    "description": "Auto-deployer for Magento 2",
    "type": "magento2-component",
    "license": "proprietary",
    "authors": [
        {
            "name": "Taurus Media B.V."
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "deployer/deployer": "^8.0.5"
    },
    "autoload": {
        "psr-4": {
            "Taurus\\Deployer\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "extra": {
        "map": [
            [
                "deploy.php",
                "deploy.php"
            ],
            [
                "cache-warmer.py",
                "cache-warmer.py"
            ]
        ],
        "chmod": [
            {
                "mask": "0755",
                "path": "cache-warmer.py"
            }
        ]
    }
}
